# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Env files
.env

# Node
node_modules/
dist/
.vite/

# Test coverage output (backend pytest-cov + frontend Vitest)
.coverage
coverage.xml
htmlcov/
frontend/coverage/

# Editors / OS
.vscode/
.idea/
.DS_Store


# NCC/ABCB source images and their generated descriptions
backend/data/images/**
!backend/data/images/README.md
backend/data/image_descriptions/*.jsonl
backend/data/image_descriptions/*.json
ncc-2025-housing-provisions-v1.2/*
ncc-2025-volume-two-v1.2/*
# Ingest pipeline output (generated, re-run to regenerate)
backend/app/ingest/output/

# embed_chunks.py resume state. The big append-only log is local-only; the
# merged *.embedded.json is the real, shared output and .meta.json (tiny) is
# committed so everyone embeds with identical settings.
backend/app/ingest/output/embeddings/*.jsonl

# Source PDFs of the NCC 2025 / ABCB documents. Copyright ABCB, and large --
# the repo holds the parsed output, never the source documents themselves.
backend/data/source/

# Windows alternate-data-stream junk left behind when files are copied in
# from a browser download (see the cleanup in 9a1c42c).
*Zone.Identifier

# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Embeddings: Gemini gemini-embedding-2 (768-dim) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-2

# --- Generation: Gemini ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: several teammates' keys, comma-separated (no spaces needed either
# way). Used by the live app (generation, embedding, compliance analysis,
# image transcription -- see app/services/gemini_keys.py) AND by
# scripts/embed_chunks.py. When a key hits its per-minute or daily quota,
# whatever's calling it automatically moves on to the next one instead of
# failing. Overrides GEMINI_API_KEY when set.
# Get real key values from a teammate via a shared password manager entry
# (e.g. a Bitwarden/1Password shared vault) -- never via Slack/Discord/git/
# an AI chat. This file (and .env generally) is gitignored; never commit
# real keys here or anywhere else in the repo.
# GEMINI_API_KEYS=AIzaKey1,AIzaKey2,AIzaKey3

# --- Reranking: Hugging Face ---
HF_API_TOKEN=

# --- Vision: describing NCC/ABCB diagrams (scripts/describe_images.py) ---
# Uses GEMINI_API_KEY above. gemini-2.5-pro reads dense drawings more
# accurately but costs more; gemini-2.5-flash is the default.
VISION_MODEL_NAME=gemini-2.5-flash

# --- PDF parsing: LlamaParse (DOCX handled locally via python-docx) ---
PDF_PARSER=llamaparse
LLAMAPARSE_API_KEY=

CORS_ORIGINS=["http://localhost:5173"]

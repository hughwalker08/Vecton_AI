# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Embeddings: Gemini gemini-embedding-2 (768-dim) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-2

# --- Generation: Gemini ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: several keys for scripts/embed_chunks.py to rotate through when one
# hits its daily quota. Comma-separated, no spaces. Overrides GEMINI_API_KEY.
# GEMINI_API_KEYS=AIzaKey1,AIzaKey2

# --- Vision: describing NCC/ABCB diagrams (scripts/describe_images.py) ---
# Uses GEMINI_API_KEY above. gemini-2.5-pro reads dense drawings more
# accurately but costs more; gemini-2.5-flash is the default.
VISION_MODEL_NAME=gemini-2.5-flash

# --- PDF parsing: LlamaParse (DOCX handled locally via python-docx) ---
PDF_PARSER=llamaparse
LLAMAPARSE_API_KEY=

CORS_ORIGINS=["http://localhost:5173"]

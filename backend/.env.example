# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Embeddings: Gemini text-embedding-004 (768-dim) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=text-embedding-004

# --- Generation: Gemini ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# --- Vision: describing NCC/ABCB diagrams (scripts/describe_images.py) ---
# Uses GEMINI_API_KEY above. gemini-2.5-pro reads dense drawings more
# accurately but costs more; gemini-2.5-flash is the default.
VISION_MODEL_NAME=gemini-2.5-flash

# --- PDF parsing: LlamaParse (DOCX handled locally via python-docx) ---
PDF_PARSER=llamaparse
LLAMAPARSE_API_KEY=

CORS_ORIGINS=["http://localhost:5173"]
